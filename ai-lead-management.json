{
  "name": "AI Lead Management & Smart Response System",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Get in Touch",
        "formDescription": "Tell us what you need and we'll get back to you within minutes.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "placeholder": "Your full name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "placeholder": "you@company.com",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "placeholder": "Company name (optional)"
            },
            {
              "fieldLabel": "Phone",
              "placeholder": "+63 9XX XXX XXXX"
            },
            {
              "fieldLabel": "Budget",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Under $1,000"
                  },
                  {
                    "option": "$1,000 - $5,000"
                  },
                  {
                    "option": "$5,000 - $20,000"
                  },
                  {
                    "option": "$20,000+"
                  },
                  {
                    "option": "Not sure yet"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Timeline",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "ASAP"
                  },
                  {
                    "option": "Within 1 month"
                  },
                  {
                    "option": "1-3 months"
                  },
                  {
                    "option": "Just exploring"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "placeholder": "How can we help?",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "path": "lead-form"
        }
      },
      "id": "30da5d5c-96d0-4428-ade9-0e4f455f24b9",
      "name": "Receive New Lead",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -256,
        560
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "name",
              "type": "string",
              "value": "={{ ($json['Name'] || '').trim() }}"
            },
            {
              "id": "n2",
              "name": "email",
              "type": "string",
              "value": "={{ ($json['Email'] || '').trim().toLowerCase() }}"
            },
            {
              "id": "n3",
              "name": "company",
              "type": "string",
              "value": "={{ $json['Company'] || 'N/A' }}"
            },
            {
              "id": "n4",
              "name": "phone",
              "type": "string",
              "value": "={{ $json['Phone'] || '' }}"
            },
            {
              "id": "n5",
              "name": "budget",
              "type": "string",
              "value": "={{ $json['Budget'] || 'Not specified' }}"
            },
            {
              "id": "n6",
              "name": "timeline",
              "type": "string",
              "value": "={{ $json['Timeline'] || 'Not specified' }}"
            },
            {
              "id": "n7",
              "name": "message",
              "type": "string",
              "value": "={{ ($json['Message'] || '').trim() }}"
            },
            {
              "id": "n8",
              "name": "source",
              "type": "string",
              "value": "n8n Form"
            },
            {
              "id": "n9",
              "name": "received_at",
              "type": "string",
              "value": "={{ $json.submittedAt || $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c56de840-968d-4ae5-bd6d-d4b0d4eee9b6",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        64,
        560
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are an expert B2B sales lead qualification assistant. Analyze the incoming lead and score it.\n\nScoring guide (0-100):\n- Clear buying intent, defined budget, near-term timeline, decision-maker language = HOT (70-100)\n- Some interest but vague budget/timeline, researching options = WARM (40-69)\n- Generic question, no budget, no timeline, student/job seeker/spam = COLD (0-39)\n\nRespond ONLY with valid JSON in this exact format:\n{\n  \"lead_score\": number,\n  \"lead_status\": \"hot\" | \"warm\" | \"cold\",\n  \"intent\": \"short phrase describing what they want\",\n  \"summary\": \"one-sentence summary of the lead\",\n  \"reasoning\": \"why you gave this score\",\n  \"recommended_action\": \"next step for the sales team\"\n}",
              "role": "system"
            },
            {
              "content": "=Lead details:\nName: {{ $json.name }}\nEmail: {{ $json.email }}\nCompany: {{ $json.company }}\nPhone: {{ $json.phone }}\nBudget: {{ $json.budget }}\nTimeline: {{ $json.timeline }}\nSource: {{ $json.source }}\nMessage: {{ $json.message }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.2
        }
      },
      "id": "b279b488-6e83-4fd3-ab80-fa21d77ce9a2",
      "name": "Analyze & Qualify Lead",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        384,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message.content.lead_status }}",
              "rightValue": "hot",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.message.content.lead_score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "or"
        },
        "looseTypeValidation": true,
        "options": {}
      },
