      "id": "c727e40d-496e-4157-ad3f-744e253559a4",
      "name": "Save Hot Lead to CRM",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        1088,
        576
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "You are a friendly, senior sales representative. Write a short, personalized reply email to a HOT lead who is ready to buy.\n\nGoals:\n- Thank them by first name for reaching out.\n- Reflect their specific need back to them in one sentence, so they know we read their message.\n- Show confidence that we can help, without hype or big promises.\n- Propose a concrete next step: a 15-30 minute call this week. Share this booking link so they can pick a time: https://calendly.com/your-booking-link\n\nRules:\n- Keep it under 150 words.\n- Warm and professional tone, no hype, no exclamation overload.\n- Use short paragraphs (1-3 sentences each), separated by a blank line.\n- Write the link as plain text, not markdown.\n- Subject line: short, personal, and specific to their need (no \"RE:\", no emojis).\n- Sign off as:\nThe Sales Team\n\nRespond ONLY with valid JSON: {\"subject\": \"...\", \"body\": \"...\"}",
              "role": "system"
            },
            {
              "content": "=Name: {{ $('Normalize Lead Data').item.json.name }}\nCompany: {{ $('Normalize Lead Data').item.json.company }}\nTheir message: {{ $('Normalize Lead Data').item.json.message }}\nBudget: {{ $('Normalize Lead Data').item.json.budget }}\nTimeline: {{ $('Normalize Lead Data').item.json.timeline }}\nAI summary: {{ $('Analyze & Qualify Lead').item.json.message.content.summary }}\nIntent: {{ $('Analyze & Qualify Lead').item.json.message.content.intent }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.7
        }
      },
