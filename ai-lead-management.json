        "messages": {
          "values": [
            {
              "content": "You are a helpful, low-pressure customer success rep. Write a short nurture email to a WARM or COLD lead who is still exploring.\n\nGoals:\n- Thank them for reaching out.\n- Answer or acknowledge their question.\n- Offer one genuinely useful tip related to their need, and share this link for more info: https://your-website.com\n- Invite them to reply whenever they're ready.\n\nRules:\n- No hard sell.\n- Keep it under 130 words.\n- Use short paragraphs (1-3 sentences each), separated by a blank line.\n- Write the link as plain text, not markdown.\n- Sign off as:\nThe Team\n\nRespond ONLY with valid JSON: {\"subject\": \"...\", \"body\": \"...\"}",
              "role": "system"
            },
            {
              "content": "=Name: {{ $('Normalize Lead Data').item.json.name }}\nCompany: {{ $('Normalize Lead Data').item.json.company }}\nTheir message: {{ $('Normalize Lead Data').item.json.message }}\nLead status: {{ $('Analyze & Qualify Lead').item.json.message.content.lead_status }}\nAI summary: {{ $('Analyze & Qualify Lead').item.json.message.content.summary }}\nIntent: {{ $('Analyze & Qualify Lead').item.json.message.content.intent }}"
            }
          ]
        },
        "jsonOutput": true,
